generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String            @id @default(cuid())
  name         String?
  email        String            @unique
  passwordHash String
  image        String?
  plan         String            @default("free")
  /// JSON: Personal AI Developer memory — styles, themes, fonts, corrections.
  preferences  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  accounts     Account[]
  sessions     Session[]
  projects     Project[]
  assets       Asset[]
  creatives    CreativeProject[]
  leads        Lead[]
  evaluationPatterns EvaluationPattern[]
}

/// Feedback intelligence v1 — good/bad evaluation patterns for future prompts.
model EvaluationPattern {
  id        String   @id @default(cuid())
  kind      String
  dimension String
  pattern   String
  industry  String?
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([dimension, kind])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id             String           @id @default(cuid())
  title          String
  prompt         String
  html           String           @default("")
  /// Structured multi-page site JSON string (Website schema).
  data           String?
  provider       String           @default("demo")
  model          String?
  published      Boolean          @default(false)
  slug           String?          @unique
  customDomain   String?          @unique
  seoTitle       String?
  seoDescription String?
  logoUrl        String?
  viewCount      Int              @default(0)
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       Message[]
  versions       ProjectVersion[]
  leads          Lead[]
  memory         ProjectMemory?
  changes        ProjectChange[]
}

/// Structural model of a generated site: what exists, where, and how it is styled.
/// Agents read this to ground a refinement instead of regenerating from scratch.
model ProjectMemory {
  id           String       @id @default(cuid())
  brand        String
  theme        String
  /// JSON: DesignTokens overlay applied on top of the theme preset.
  designTokens String?
  /// JSON: Magic DesignSystem (colors, typography, spacing, buttons).
  designSystem String?
  /// JSON: Magic Blueprint snapshot (strategy before build).
  blueprint    String?
  /// JSON: compact site digest injected into agent prompts.
  digest       String?
  revision     Int          @default(1)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  projectId    String       @unique
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pages        MemoryPage[]
}

model MemoryPage {
  id       String          @id @default(cuid())
  slug     String
  title    String
  order    Int             @default(0)
  memoryId String
  memory   ProjectMemory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  sections MemorySection[]

  @@unique([memoryId, slug])
}

model MemorySection {
  id         String            @id @default(cuid())
  /// Stable instance key, e.g. "home.hero_split#0".
  key        String
  /// Section type id from the section registry, e.g. "hero_split".
  type       String
  order      Int               @default(0)
  /// JSON: DesignTokens overlay scoped to this section only.
  tokens     String?
  pageId     String
  page       MemoryPage        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  components MemoryComponent[]

  @@unique([pageId, key])
}

model MemoryComponent {
  id              String        @id @default(cuid())
  /// Stable key, e.g. "home.hero_split#0.ctaLabel".
  key             String
  /// Slot name inside the section, e.g. "ctaLabel".
  slot            String
  /// button | heading | text | image | list.
  kind            String
  /// Current value snapshot (text, image URL, or item summary).
  value           String?
  order           Int           @default(0)
  memorySectionId String
  section         MemorySection @relation(fields: [memorySectionId], references: [id], onDelete: Cascade)

  @@unique([memorySectionId, key])
}

/// Append-only log of every agent run against a project.
model ProjectChange {
  id        String   @id @default(cuid())
  /// generate | refine.
  kind      String
  request   String
  summary   String
  /// applied | no_op | failed.
  status    String   @default("applied")
  passed    Boolean  @default(true)
  attempts  Int      @default(1)
  /// JSON: planner output (intent, targets, steps).
  plan      String?
  /// JSON: patch operations the developer/fix agents applied.
  patch     String?
  /// JSON: reviewer issues remaining after the final pass.
  issues    String?
  /// JSON: ordered agent events for this run.
  trace     String?
  /// ProjectVersion snapshot taken before this change was applied.
  versionId String?
  createdAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ProjectVersion {
  id        String   @id @default(cuid())
  label     String?
  html      String
  data      String?
  createdAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Asset {
  id        String   @id @default(cuid())
  name      String
  url       String
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(cuid())
  role      String
  content   String
  createdAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model CreativeProject {
  id                String   @id @default(cuid())
  title             String
  prompt            String
  referenceImageUrl String?
  status            String   @default("draft")
  /// JSON: script, scenes, assets, stage progress
  data              String?
  outputUrl         String?
  voiceoverUrl      String?
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
