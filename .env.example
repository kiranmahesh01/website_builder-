# Postgres (Neon / Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Vercel Blob for uploads in production
# BLOB_READ_WRITE_TOKEN=""

# ── LLM (NVIDIA NIM — preferred: 100+ free models, ~40 req/min, no credit card) ──
# Get key: https://build.nvidia.com  •  browse models: https://build.nvidia.com/models
# When set, this becomes the default provider — its models follow JSON
# instructions far more reliably than the OpenRouter free pool.
NVIDIA_API_KEY=""
# Run `npx tsx scripts/probe-nvidia.ts` to re-measure and pick the best models.
# Chosen for latency: the pipeline makes several calls inside a 120s budget, so
# frontier models that take 60-90s per call are not usable here.
NVIDIA_MODEL="deepseek-ai/deepseek-v4-flash"
NVIDIA_FALLBACK_MODELS="openai/gpt-oss-120b,nvidia/nemotron-3-ultra-550b-a55b"
NVIDIA_VISION_MODEL="meta/llama-3.2-90b-vision-instruct"

# ── LLM (OpenRouter — free models at https://openrouter.ai/models?max_price=0) ──
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Primary model — "openrouter/free" auto-picks best free model (recommended)
OPENROUTER_MODEL="openrouter/free"
# Optional override. When NVIDIA_API_KEY is set, NVIDIA is used first regardless.
DEFAULT_LLM_PROVIDER="nvidia"
# Free models for race mode + automatic fallbacks (comma-separated)
OPENROUTER_BEST_MODELS="google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,openai/gpt-oss-20b:free,nvidia/nemotron-3-nano-30b-a3b:free"
OPENROUTER_FALLBACK_MODELS="openrouter/free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,openai/gpt-oss-20b:free"
# Free multimodal model for Creative Studio reference images
OPENROUTER_VISION_MODEL="google/gemma-4-26b-a4b-it:free"

# Optional backup providers (not required if OpenRouter is set)
OPENAI_API_KEY=""
GOOGLE_AI_API_KEY=""
BYTEZ_API_KEY=""

# Optional model overrides
# OPENAI_MODEL="gpt-4o-mini"
# GEMINI_MODEL="gemini-2.0-flash"
BYTEZ_MODEL="Qwen/Qwen3-4B"

# Stock photos for generated sites (optional — Openverse/Wikimedia work without keys)
PEXELS_API_KEY=""
PIXABAY_API_KEY=""
UNSPLASH_ACCESS_KEY=""

# ── Creative Studio (promo video pipeline) ──
REPLICATE_API_TOKEN=""
ELEVENLABS_API_KEY=""
CARTESIA_API_KEY=""

# demo = offline templates only. Do not use in production.
# DEFAULT_LLM_PROVIDER="demo"
