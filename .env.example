DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# LLM keys — optional when DEFAULT_LLM_PROVIDER=demo (local schema templates, no external API).
# These are NOT Cursor keys. Cursor is not an AI provider for this app.
# For real AI generation, add at least one key:
#   OpenRouter (Gemma etc.): https://openrouter.ai/keys
#   Gemini (free tier): https://aistudio.google.com/apikey
#   OpenAI: https://platform.openai.com/api-keys
#   Bytez (free $1 credits / 4 weeks): https://bytez.com/api/key
# Anthropic is not configured by default — add your own integration if needed.
# These are NOT the same as ngrok.
OPENAI_API_KEY=""
GOOGLE_AI_API_KEY=""
BYTEZ_API_KEY=""
OPENROUTER_API_KEY=""

# Optional model overrides
# OPENAI_MODEL="gpt-4o-mini"
# GEMINI_MODEL="gemini-2.0-flash"
# Free-tier open chat model (≤7B). Docs example: Qwen/Qwen3-4B
BYTEZ_MODEL="Qwen/Qwen3-4B"
# OpenRouter model id (GPT-4o mini works well for schema JSON)
OPENROUTER_MODEL="openai/gpt-4o-mini"
# Comma-separated free models for Best-of-N (parallel)
OPENROUTER_BEST_MODELS="google/gemma-4-26b-a4b-it:free,openai/gpt-oss-20b:free,nvidia/nemotron-3-nano-30b-a3b:free"

# demo | openai | gemini | bytez | openrouter | openrouter-best
# Use "demo" to try Generate / Publish without API keys.
# Set to "openrouter" after adding OPENROUTER_API_KEY to prefer OpenRouter + Gemma.
DEFAULT_LLM_PROVIDER="openrouter-best"

# ngrok auth token — optional. Used only to expose the local app publicly.
# Run: npm run tunnel  (while `npm run dev` is already running)
# Publish still uses /s/[slug] locally; ngrok tunnels the whole Next.js app.
NGROK_AUTHTOKEN=""
