# Postgres (Neon / Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Vercel Blob for uploads in production
# BLOB_READ_WRITE_TOKEN=""

# ── LLM (OpenRouter is primary — one key powers generation) ──
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
DEFAULT_LLM_PROVIDER="openrouter"

# Optional backup providers (not required if OpenRouter is set)
OPENAI_API_KEY=""
GOOGLE_AI_API_KEY=""
BYTEZ_API_KEY=""

# Optional model overrides
# OPENAI_MODEL="gpt-4o-mini"
# GEMINI_MODEL="gemini-2.0-flash"
BYTEZ_MODEL="Qwen/Qwen3-4B"
# Free models for race mode (optional)
OPENROUTER_BEST_MODELS="google/gemma-4-26b-a4b-it:free,openai/gpt-oss-20b:free"

# Stock photos for generated sites (optional — Openverse/Wikimedia work without keys)
# Recommended: Pexels + Pixabay (no attribution, generous free tiers)
PEXELS_API_KEY=""
PIXABAY_API_KEY=""
UNSPLASH_ACCESS_KEY=""

# ── Creative Studio (promo video pipeline) ──
# Script: uses OPENROUTER_API_KEY (above)
# AI stills + image-to-video: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=""
# Voiceover: ElevenLabs (https://elevenlabs.io) or Cartesia (https://cartesia.ai)
ELEVENLABS_API_KEY=""
# ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
CARTESIA_API_KEY=""
# CARTESIA_VOICE_ID=""
# Vision model for reference image analysis
# OPENROUTER_VISION_MODEL="google/gemini-2.0-flash-001"

# demo = offline templates only. Do not use in production.
# DEFAULT_LLM_PROVIDER="demo"
